{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/noms/recipe-import/import-candidate.v1.schema.json",
  "title": "Noms recipe import candidate v1",
  "description": "Preview-only evidence produced from an untrusted clipboard payload before a user confirms a private recipe draft.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "parser", "source", "fields", "unclassifiedLines", "competingCandidates", "warnings", "discardedContent"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["ready", "needs_review", "unsupported"] },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "tier", "sourceAdapter"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "tier": { "enum": ["generic_html", "generic_text", "source_adapter", "none"] },
        "sourceAdapter": { "oneOf": [{ "$ref": "#/$defs/nonEmptyString" }, { "type": "null" }] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suppliedUrl", "normalizedUrl", "provider", "author", "attribution", "provenance"],
      "properties": {
        "suppliedUrl": { "$ref": "#/$defs/nullableHttpUrl" },
        "normalizedUrl": { "$ref": "#/$defs/nullableHttpUrl" },
        "provider": { "$ref": "#/$defs/nullableString" },
        "author": { "$ref": "#/$defs/nullableString" },
        "attribution": { "$ref": "#/$defs/nullableString" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["suppliedUrl", "normalizedUrl", "provider", "author", "attribution"],
          "properties": {
            "suppliedUrl": { "$ref": "#/$defs/optionalProvenance" },
            "normalizedUrl": { "$ref": "#/$defs/optionalProvenance" },
            "provider": { "$ref": "#/$defs/optionalProvenance" },
            "author": { "$ref": "#/$defs/optionalProvenance" },
            "attribution": { "$ref": "#/$defs/optionalProvenance" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "suppliedUrl": { "type": "null" } } },
          "then": { "properties": { "provenance": { "properties": { "suppliedUrl": { "maxItems": 0 } } } } },
          "else": { "properties": { "provenance": { "properties": { "suppliedUrl": { "minItems": 1 } } } } }
        },
        {
          "if": { "properties": { "normalizedUrl": { "type": "null" } } },
          "then": { "properties": { "provenance": { "properties": { "normalizedUrl": { "maxItems": 0 } } } } },
          "else": { "properties": { "provenance": { "properties": { "normalizedUrl": { "minItems": 1 } } } } }
        },
        {
          "if": { "properties": { "provider": { "type": "null" } } },
          "then": { "properties": { "provenance": { "properties": { "provider": { "maxItems": 0 } } } } },
          "else": { "properties": { "provenance": { "properties": { "provider": { "minItems": 1 } } } } }
        },
        {
          "if": { "properties": { "author": { "type": "null" } } },
          "then": { "properties": { "provenance": { "properties": { "author": { "maxItems": 0 } } } } },
          "else": { "properties": { "provenance": { "properties": { "author": { "minItems": 1 } } } } }
        },
        {
          "if": { "properties": { "attribution": { "type": "null" } } },
          "then": { "properties": { "provenance": { "properties": { "attribution": { "maxItems": 0 } } } } },
          "else": { "properties": { "provenance": { "properties": { "attribution": { "minItems": 1 } } } } }
        }
      ]
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "prepTime", "cookTime", "totalTime", "yield", "ingredientSections", "instructionSections", "equipment", "notes", "images"],
      "properties": {
        "title": { "$ref": "#/$defs/nullableTextField" },
        "description": { "$ref": "#/$defs/nullableTextField" },
        "prepTime": { "$ref": "#/$defs/nullableDurationField" },
        "cookTime": { "$ref": "#/$defs/nullableDurationField" },
        "totalTime": { "$ref": "#/$defs/nullableDurationField" },
        "yield": { "$ref": "#/$defs/nullableYieldField" },
        "ingredientSections": { "type": "array", "items": { "$ref": "#/$defs/ingredientSection" } },
        "instructionSections": { "type": "array", "items": { "$ref": "#/$defs/instructionSection" } },
        "equipment": { "type": "array", "items": { "$ref": "#/$defs/candidateLine" } },
        "notes": { "type": "array", "items": { "$ref": "#/$defs/candidateLine" } },
        "images": { "type": "array", "items": { "$ref": "#/$defs/image" } }
      }
    },
    "unclassifiedLines": { "type": "array", "items": { "$ref": "#/$defs/rawLine" } },
    "competingCandidates": { "type": "array", "items": { "$ref": "#/$defs/competingCandidate" } },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } },
    "discardedContent": { "type": "array", "items": { "$ref": "#/$defs/discardedContent" } }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "nullableString": { "oneOf": [{ "$ref": "#/$defs/nonEmptyString" }, { "type": "null" }] },
    "nullableHttpUrl": { "oneOf": [{ "type": "string", "format": "uri", "pattern": "^https?://" }, { "type": "null" }] },
    "confidence": { "enum": ["high", "medium", "low"] },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["representation", "locator"],
        "properties": {
          "representation": { "enum": ["text/html", "text/plain", "source_url", "provider_selection"] },
          "locator": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "optionalProvenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["representation", "locator"],
        "properties": {
          "representation": { "enum": ["text/html", "text/plain", "source_url", "provider_selection"] },
          "locator": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "textField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "value", "confidence", "provenance"],
      "properties": {
        "raw": { "$ref": "#/$defs/nonEmptyString" },
        "value": { "$ref": "#/$defs/nonEmptyString" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "nullableTextField": { "oneOf": [{ "$ref": "#/$defs/textField" }, { "type": "null" }] },
    "durationField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "value", "confidence", "provenance"],
      "properties": {
        "raw": { "$ref": "#/$defs/nonEmptyString" },
        "value": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "confidence": { "$ref": "#/$defs/confidence" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "nullableDurationField": { "oneOf": [{ "$ref": "#/$defs/durationField" }, { "type": "null" }] },
    "yieldField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "value", "confidence", "provenance"],
      "properties": {
        "raw": { "$ref": "#/$defs/nonEmptyString" },
        "value": {
          "oneOf": [
            { "type": "null" },
            { "type": "object", "additionalProperties": false, "required": ["display", "servings"], "properties": { "display": { "$ref": "#/$defs/nonEmptyString" }, "servings": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] } } }
          ]
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "nullableYieldField": { "oneOf": [{ "$ref": "#/$defs/yieldField" }, { "type": "null" }] },
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "amount", "unit", "name", "confidence", "provenance"],
      "properties": {
        "raw": { "$ref": "#/$defs/nonEmptyString" },
        "amount": { "$ref": "#/$defs/nullableString" },
        "unit": { "$ref": "#/$defs/nullableString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "ingredientSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "items"],
      "properties": { "name": { "$ref": "#/$defs/nullableString" }, "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ingredient" } } }
    },
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "text", "confidence", "provenance", "substeps"],
      "properties": {
        "raw": { "$ref": "#/$defs/nonEmptyString" },
        "text": { "$ref": "#/$defs/nonEmptyString" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "substeps": { "type": "array", "items": { "$ref": "#/$defs/instruction" } }
      }
    },
    "instructionSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "steps"],
      "properties": { "name": { "$ref": "#/$defs/nullableString" }, "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/instruction" } } }
    },
    "candidateLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "value", "confidence", "provenance"],
      "properties": { "raw": { "$ref": "#/$defs/nonEmptyString" }, "value": { "$ref": "#/$defs/nonEmptyString" }, "confidence": { "$ref": "#/$defs/confidence" }, "provenance": { "$ref": "#/$defs/provenance" } }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceUrl", "alt", "credit", "provenance"],
      "properties": { "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https?://" }, "alt": { "$ref": "#/$defs/nullableString" }, "credit": { "$ref": "#/$defs/nullableString" }, "provenance": { "$ref": "#/$defs/provenance" } }
    },
    "rawLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "provenance"],
      "properties": { "raw": { "$ref": "#/$defs/nonEmptyString" }, "provenance": { "$ref": "#/$defs/provenance" } }
    },
    "competingCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "reason", "provenance"],
      "properties": {
        "title": { "$ref": "#/$defs/nullableString" },
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "path", "message"],
      "properties": { "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "severity": { "enum": ["info", "warning", "error"] }, "path": { "$ref": "#/$defs/nonEmptyString" }, "message": { "$ref": "#/$defs/nonEmptyString" } }
    },
    "discardedContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "count", "reason"],
      "properties": { "kind": { "$ref": "#/$defs/nonEmptyString" }, "count": { "type": "integer", "minimum": 1 }, "reason": { "$ref": "#/$defs/nonEmptyString" } }
    }
  }
}
