# Local development environment variables
# Copy this file to .env.local and fill in the values:
#   cp .env.local.example .env.local

# Environment — set to "local" to disable Secure cookie flag for HTTP localhost dev
NOMS_ENV=local

# Reverse proxies whose direct connection addresses may supply X-Forwarded-For
# or X-Real-IP. Empty is the secure default for direct local development.
TRUSTED_PROXIES=

# PostgreSQL (local Docker) — used by sqlx (DATABASE_URL) and pgschema (PG* vars)
DATABASE_URL=postgres://noms:noms_local_pass@localhost:5432/noms

# Production applies these bounded defaults to every pooled connection. They
# are optional locally and shown here so expensive-query behavior is easy to
# reproduce while tuning. MIGRATION_DATABASE_URL is production-only; isolated
# development applies schema with its dedicated schema-init container.
DB_MAX_CONNECTIONS=5
DB_ACQUIRE_TIMEOUT_SECS=10
DB_IDLE_TIMEOUT_SECS=300
DB_STATEMENT_TIMEOUT_MS=15000
DB_TRANSACTION_TIMEOUT_MS=30000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000

# Individual PostgreSQL connection parameters — used by pgschema
# These must match the components of DATABASE_URL above.
PGHOST=localhost
PGPORT=5432
PGDATABASE=noms
PGUSER=noms
PGPASSWORD=noms_local_pass

# R2 storage (local MinIO) — used by storage module
# Used for media file uploads during development
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=noms-local-key
R2_SECRET_ACCESS_KEY=noms-local-secret
R2_BUCKET=noms-media
R2_PUBLIC_URL=http://localhost:9000/noms-media

# Google OAuth (local mock server — issuer-prefixed URLs)
GOOGLE_CLIENT_ID=google
GOOGLE_CLIENT_SECRET=secret
GOOGLE_AUTH_URL=http://localhost:8082/google/authorize
GOOGLE_TOKEN_URL=http://localhost:8082/google/token
GOOGLE_USERINFO_URL=http://localhost:8082/google/userinfo

# GitHub OAuth (local mock server — issuer-prefixed URLs)
GITHUB_CLIENT_ID=github
GITHUB_CLIENT_SECRET=secret
# NAV's local OIDC mock requires openid in addition to GitHub's required scopes.
GITHUB_OAUTH_EXTRA_SCOPES=openid
GITHUB_AUTH_URL=http://localhost:8082/github/authorize
GITHUB_TOKEN_URL=http://localhost:8082/github/token
# Run the local mock-github-api service on port 8083 for these REST endpoints.
GITHUB_USERINFO_URL=http://localhost:8083/github/userinfo
GITHUB_EMAILS_URL=http://localhost:8083/github/emails

# Apple-specific fields can be left empty for local mock testing
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Session cookie signing
# Must be a random string. Use a secure random value in production!
SESSION_SECRET=change-me-in-production-use-rust-random-uuid

# Cookie domain (optional)
# Set to restrict the session cookie to a specific domain and its subdomains.
# Example: .example.com (note the leading dot for subdomain inclusion)
# Leave empty or unset to use the default behavior (cookie scoped to current host)
# COOKIE_DOMAIN=.example.com
